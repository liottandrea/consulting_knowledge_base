# Copy this file to .env and adjust as needed.
# Everything here is optional local config — none of it is a secret. No
# external API is called by this project; these vars just point the
# pipeline/server at local models, ports, and paths.

# Ollama model used for wiki synthesis
WIKI_MODEL=qwen3.6:35b

# Ollama API base URL
OLLAMA_HOST=http://localhost:11434

# qmd hybrid search mode: query (hybrid) / search (BM25) / vsearch (vector)
QMD_MODE=query

# Enable qmd's LLM reranker for better ordering (unset by default)
#QMD_RERANK=1

# Force the qmd CLI per call instead of the warm daemon (unset by default)
#QMD_NO_DAEMON=1

# Port for the persistent qmd daemon
QMD_DAEMON_PORT=8181

# qmd index + collection to search
QMD_INDEX=index
QMD_COLLECTION=wiki

# Wiki directory (used by kb_info)
WIKI_DIR=./wiki

# Manifest path (Docker keeps it under logs/)
KB_MANIFEST=./manifest.json

# MCP transport: stdio (default, local CLI use) or streamable-http (Docker service)
MCP_TRANSPORT=stdio

# HTTP bind for the MCP service (only used with streamable-http)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Tokenizer cache location (ingest) — defaults to the standard HF cache dir
#HF_HOME=./hf-cache
